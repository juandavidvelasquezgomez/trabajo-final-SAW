# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.

# Clave para firmar los tokens. Obligatoria: mínimo 32 caracteres, aleatoria y privada.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ruta del archivo SQLite (opcional). Por defecto: backend/db/eventos.db
DATABASE_PATH=

# Contraseña de las cuentas de prueba que crea seed.py (opcional).
# Si se deja vacía, seed.py genera una aleatoria y la muestra una sola vez.
SEED_PASSWORD=

# Dirección que se codifica en los códigos QR (opcional). Por defecto, la usada para abrir la app.
# Para escanear con un celular de la misma red, por ejemplo: URL_PUBLICA=http://192.168.1.20:8000
URL_PUBLICA=
